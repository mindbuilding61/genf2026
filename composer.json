{
    "name": "mindbuilding/genf2026",
    "type": "typo3-cms-extension",
    "description": "Site package Genf with megamenu layout",
    "homepage": "https://mindbuilding.de",
    "license": ["GPL-2.0-or-later"],
    "keywords": ["TYPO3 CMS"],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.3",
        "typo3/cms-rte-ckeditor": "^13.4 || ^14.3",
        "b13/container": "^3.2 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mindbuilding\\Genf\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "genf2026",
            "version": "1.1.2",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
